# Campaign history: large, per-machine, and merge-hostile. Each checkout keeps
# its own. See README.md § "What this repo does not carry".
run-logs/*
!run-logs/.gitkeep

# Design workspaces. These are git repos of their own, holding pipeline output
# generated from a brief — recreate one with bin/new-workspace.sh rather than
# cloning it. They belong beside the harness, not inside it; these entries only
# catch the ones that already live here.
/bench-psu/
/joystick/
/lemondrop/
/midi-pedal/
/rc600/
/reenvo/
/sensor-node/
*.kicad_sch
*.kicad_pcb
*.kicad_pro
*.kicad_prl
.copperhead/

# KiCad's git-backed project history
.history/

node_modules/
.DS_Store
