# Design workspaces. Each is a git repo of its own holding pipeline output
# generated from a brief — recreate one with bin/new-workspace.sh rather than
# cloning it.
/workspaces/*
!/workspaces/.gitkeep

# Campaign history: large, per-machine, and merge-hostile. Each checkout keeps
# its own. See README.md § "What this repo does not carry".
/run-logs/*
!/run-logs/.gitkeep

# KiCad's git-backed project history
.history/

node_modules/
.DS_Store
